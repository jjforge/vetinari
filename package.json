{
  "name": "sandcastle-tdd",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parallel TDD agent orchestrator on @ai-hero/sandcastle: the orchestrator owns the test gate, blocked agents park instead of guessing, and questions round-trip through Telegram.",
  "license": "MIT",
  "bin": {
    "sandcastle-tdd": "./src/cli.mts"
  },
  "exports": {
    ".": "./src/index.ts",
