[Unit]
Description=vetinari gateway (host Telegram router)
After=docker.service network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/env bash -lc 'set -a; source %h/.config/vetinari/gateway.env; set +a; exec vetinari gateway'
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
