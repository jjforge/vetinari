{
  "name": "vetinari",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Parallel TDD agent orchestrator on @ai-hero/sandcastle: the orchestrator owns the test gate, blocked agents park instead of guessing, and questions round-trip through Telegram.",
  "license": "MIT",
  "engines": {
    "node": ">=22.15"
  },
  "bin": {
    "vetinari": "./src/cli.mts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.mts",
    "./prompts/tdd.md": "./prompts/tdd.md"
  },
  "scripts": {
    "vetinari": "tsx ./src/cli.mts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --import \"$PWD/src/test-setup.ts\" src/*.test.ts",
    "gen-reference": "tsx ./scripts/gen-reference.ts",
    "check-contract": "tsx ./src/check-contract.mts",
    "format": "prettier --write \"**/*.{ts,mts,js,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,mts,js,mjs}\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ai-hero/sandcastle": "git+https://github.com/zachthieme/sandcastle.git#v0.12.0-statedir.3",
    "tsx": "4.23.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "10.14.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.9",
    "typescript": "^5.9.0",
    "typescript-eslint": "8.72.1"
  }
}
