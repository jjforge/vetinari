    "./prompts/tdd.md": "./prompts/tdd.md"
  },
  "scripts": {
    "sandcastle-tdd": "tsx ./src/cli.mts",
    "typecheck": "tsc --noEmit",
    "check-contract": "tsx ./src/check-contract.mts"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "tsx": "^4.23.10"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  }
}
